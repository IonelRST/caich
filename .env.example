# =============================================================================
# caich — plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` NUNCA se sube al repositorio (está en .gitignore).
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Panel de Supabase → Project Settings → Data API
#
# URL del proyecto. Es el identificador que aparece en la barra de direcciones
# del panel (supabase.com/dashboard/project/XXXX) más el dominio.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# "Publishable key" (antes llamada "anon key").
# Es pública por diseño: viaja al navegador. Lo que aísla los datos es Row Level
# Security (migración 0001), no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NO uses aquí la "Secret key" (antes "service_role"): salta RLS por completo y
# daría acceso a los datos de cualquier usuario. La app no la necesita.

# --- API de Claude ------------------------------------------------------------
# https://platform.claude.com → API Keys
#
# Solo se usa en el servidor. Sin prefijo NEXT_PUBLIC_, para que nunca llegue al
# navegador: una clave expuesta en el cliente la puede gastar cualquiera.
ANTHROPIC_API_KEY=
