# =============================================================================
# caich — plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` NUNCA se sube al repositorio (está en .gitignore).
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Se obtienen en el panel del proyecto: Project Settings > API
# La "anon key" es pública por diseño: el aislamiento real lo da RLS (migración 0001).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API de Claude ------------------------------------------------------------
# Se obtiene en https://platform.claude.com  → API Keys
# Solo se usa en el servidor. Sin prefijo NEXT_PUBLIC_, para que nunca llegue
# al navegador: una clave expuesta en el cliente la puede usar cualquiera.
ANTHROPIC_API_KEY=
